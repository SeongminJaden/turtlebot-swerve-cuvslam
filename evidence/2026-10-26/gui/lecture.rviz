Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 22; 30; 45
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/MarkerArray
      Name: Recorded maze and robot
      Enabled: true
      Topic:
        Value: /lecture/maze_and_robot
        Depth: 5
    - Class: rviz_default_plugins/Path
      Name: Actual PhysX path
      Enabled: true
      Topic:
        Value: /lecture/measured_path
        Depth: 5
      Color: 255; 170; 30
      Line Style: Lines
      Line Width: 0.03
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 2.2
        Y: 3.1
        Z: 0
      Pitch: 1.15
      Yaw: 4.7
Window Geometry:
  Width: 1280
  Height: 800
  X: 50
  Y: 50
