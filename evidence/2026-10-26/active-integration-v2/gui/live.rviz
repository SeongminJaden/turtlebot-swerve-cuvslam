Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 22; 30; 45
    Fixed Frame: odom
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (0.1 m)
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Path
      Name: cuVSLAM + arm FK base path
      Enabled: true
      Topic:
        Value: /active_camera/base_path
        Depth: 5
      Color: 70; 210; 190
      Line Style: Lines
      Line Width: 0.01
    - Class: rviz_default_plugins/Pose
      Name: Corrected base pose
      Enabled: true
      Topic:
        Value: /active_camera/base_pose
        Depth: 5
      Shape: Axes
      Axes Length: 0.2
      Axes Radius: 0.01
    - Class: rviz_default_plugins/Image
      Name: Live arm left stereo
      Enabled: true
      Topic:
        Value: /arm_stereo/left/image_rect
        Depth: 5
      Normalize Range: true
      Transport Hint: raw
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2
      Focal Point:
        X: 0
        Y: 0
        Z: -0.4
      Pitch: 0.8
      Yaw: 4.7
Window Geometry:
  Width: 1280
  Height: 800
  X: 60
  Y: 60
