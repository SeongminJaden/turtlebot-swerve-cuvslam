#usda 1.0
(
    "OpenMANIPULATOR-X stock yaw +/-180 deg reference; custom CAD sampled mesh screen, hardware cable limits unqualified. Stereo rig fixed to arm_link5. Other joints held at zero."
    defaultPrim = "Robot"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Robot" (
    prepend references = @./m38_runtime.usda@
)
{
    over "Joints"
    {
        over "arm_joint1"
        {
            float physics:lowerLimit = -180
            float physics:upperLimit = 180
        }
    }

    over "arm_link5"
    {
        def Xform "camera_rig"
        {
            double3 xformOp:translate = (0.04742, 0, 0.059)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Camera "left"
            {
                float2 clippingRange = (0.02, 100)
                float focalLength = 20
                float horizontalAperture = 32
                float verticalAperture = 24
                float3 xformOp:rotateXYZ = (90, 0, -90)
                double3 xformOp:translate = (0, 0.025, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            }

            def Camera "right"
            {
                float2 clippingRange = (0.02, 100)
                float focalLength = 20
                float horizontalAperture = 32
                float verticalAperture = 24
                float3 xformOp:rotateXYZ = (90, 0, -90)
                double3 xformOp:translate = (0, -0.025, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            }
        }
    }
}
