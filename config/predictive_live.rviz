Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 22; 30; 45
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (0.1 m)
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 50
    - Class: rviz_default_plugins/Path
      Name: cuVSLAM + arm FK base path
      Enabled: true
      Topic:
        Value: /active_camera/base_path
        Depth: 5
      Color: 70; 210; 190
      Line Style: Lines
      Line Width: 0.01
    - Class: rviz_default_plugins/Pose
      Name: Corrected base pose
      Enabled: true
      Topic:
        Value: /active_camera/base_pose
        Depth: 5
      Shape: Axes
      Axes Length: 0.2
      Axes Radius: 0.01
    - Class: rviz_default_plugins/Image
      Name: Live arm left stereo
      Enabled: true
      Topic:
        Value: /arm_stereo/left/image_rect
        Depth: 5
      Normalize Range: true
      Transport Hint: raw
    - Class: rviz_default_plugins/Map
      Name: CAD maze map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Alpha: 0.7
    - Class: rviz_default_plugins/LaserScan
      Name: Arm depth measured obstacles
      Enabled: true
      Topic:
        Value: /arm_depth/scan
        Reliability Policy: Best Effort
        Depth: 5
      Size (m): 0.025
      Style: Spheres
      Color Transformer: FlatColor
      Color: 250; 177; 70
    - Class: rviz_default_plugins/Odometry
      Name: Encoders + dual IMU + cuVSLAM EKF
      Enabled: true
      Topic:
        Value: /odometry/filtered
        Depth: 5
      Keep: 20
      Shape: Arrow
    - Class: rviz_default_plugins/TF
      Name: Robot and moving camera frames
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.2
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.2
      Focal Point:
        X: 1.9
        Y: 1.6
        Z: 0
      Pitch: 0.8
      Yaw: 4.7
Window Geometry:
  Width: 1280
  Height: 800
  X: 60
  Y: 60
